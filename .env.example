# Copy to .env.local (untracked) and edit. RoomScale has no backend, so nothing
# here is a secret — these only affect local development.

# Hostnames the dev server may be reached on besides localhost. Needed when you
# browse it through a tunnel, a reverse proxy, or another machine's hostname.
# Comma separated, no scheme.
# DEV_ORIGINS=my-box,my-box.example.net,10.0.0.4
